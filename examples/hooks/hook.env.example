# Save as ~/.config/agent-memory/hook.env and protect with: chmod 600 ~/.config/agent-memory/hook.env
# Process environment variables override values defined here.

MEMORY_SERVER_URL=http://127.0.0.1:7337
MEMORY_SERVER_TOKEN=replace-with-your-memory-server-token

# Optional overrides (leave unset to use server defaults — shared global write scope):
# MEMORY_SCOPE=global
# MEMORY_HOOK_RECALL_TIMEOUT_MS=1800
# MEMORY_HOOK_CAPTURE_TIMEOUT_MS=25000
# MEMORY_HOOK_RECALL_MAX_ITEMS=3
# MEMORY_HOOK_RECALL_MAX_CHARS=600
# MEMORY_HOOK_RECALL_MIN_REPEATED=8
# MEMORY_HOOK_INCLUDE_ASSISTANT=true
