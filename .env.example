# Required for memory operations. Generate a long random value, for example:
#   openssl rand -hex 32
MEMORY_SERVER_TOKEN=change-me-before-use

# Docker Compose publishes to loopback by default. Set 0.0.0.0 only when you
# intentionally want LAN/WAN access and have a private-network/TLS boundary.
MEMORY_SERVER_BIND_ADDRESS=127.0.0.1

# Add the hostname/IP clients actually use when exposing beyond loopback.
MEMORY_SERVER_ALLOWED_HOSTS=localhost,127.0.0.1,memory-server
MEMORY_SERVER_ALLOWED_ORIGINS=localhost,127.0.0.1,memory-server

# Choose models explicitly for your deployment. Agent Memory does not select
# embedding or extraction models on your behalf.
MEMORY_EMBEDDING_BASE_URL=http://your-embedding-provider/v1
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=your-embedding-model
MEMORY_EMBEDDING_DIMENSIONS=your-embedding-dimension
MEMORY_LLM_BASE_URL=https://your-llm-provider/v1
MEMORY_LLM_API_KEY=replace-with-provider-key
MEMORY_LLM_MODEL=your-extraction-model
MEMORY_LLM_TIMEOUT_MS=180000
# Optional. Leave blank to use the provider/model default reasoning behavior.
MEMORY_LLM_THINK_LEVEL=
