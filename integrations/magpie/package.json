{
  "name": "magpie-agent-memory",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared long-term memory for every agent routed through Magpie — automatic pre-request recall and background capture powered by Agent Memory Server.",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-hooks",
    "agent-memory",
    "ai-memory",
    "long-term-memory",
    "llm-gateway"
  ],
  "author": "Masikomoore",
  "license": "MIT",
  "homepage": "https://github.com/Masikomoore/agent-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Masikomoore/magpie-agent-memory.git"
  },
  "bugs": {
    "url": "https://github.com/Masikomoore/agent-memory/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "agent-memory.hooks.mjs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "magpie": {
    "hooks": "./agent-memory.hooks.mjs",
    "icon": "data:image/svg+xml;base64,",
    "options": {
      "serverUrl": "http://127.0.0.1:7337",
      "gatewayTimeoutMs": 8000,
      "recallTimeoutMs": 2500,
      "recallEnabled": true,
      "captureEnabled": true,
      "maxItems": 3,
      "maxChars": 600,
      "minRepeatedTurns": 8,
      "skipAgents": [],
      "skipCaptureAgents": []
    }
  }
}
